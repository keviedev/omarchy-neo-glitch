# Neo Glitch - cyberpunk glitch btop theme
# RGB-split neon on void black

# Base
theme[main_bg]="#0a0612"
theme[main_fg]="#d8f0ff"
theme[title]="#00e5ff"
theme[subtitle]="#ea00d9"
theme[hi_fg]="#ea00d9"
theme[inactive_fg]="#5d4a7a"
theme[graph_text]="#b4c8e0"

# Boxes - one neon per subsystem
theme[cpu_box]="#00e5ff"
theme[mem_box]="#00ff9f"
theme[net_box]="#ff2a6d"
theme[proc_box]="#ea00d9"
theme[temp_box]="#f9f871"
theme[div_line]="#2a1040"

# Selection
theme[selected_bg]="#2a1040"
theme[selected_fg]="#00ff9f"
theme[meter_bg]="#1c0f2e"

# Temperature: cyan -> magenta -> red alert
theme[temp_start]="#00e5ff"
theme[temp_mid]="#ea00d9"
theme[temp_end]="#ff2a6d"

# CPU graph: glitch RGB split
theme[cpu_start]="#00ff9f"
theme[cpu_mid]="#00e5ff"
theme[cpu_end]="#ea00d9"

# Mem/Disk meters
theme[free_start]="#ea00d9"
theme[free_mid]="#0abdc6"
theme[free_end]="#00ff9f"
theme[cached_start]="#0abdc6"
theme[cached_mid]="#00e5ff"
theme[cached_end]="#ea00d9"
theme[available_start]="#f9f871"
theme[available_mid]="#ff9e4f"
theme[available_end]="#ff2a6d"
theme[used_start]="#00ff9f"
theme[used_mid]="#00e5ff"
theme[used_end]="#0abdc6"

# Network: neon magenta in, cyan out
theme[download_start]="#ea00d9"
theme[download_mid]="#ff6bff"
theme[download_end]="#f4faff"
theme[upload_start]="#00e5ff"
theme[upload_mid]="#6ff9ff"
theme[upload_end]="#f4faff"

# Process gradient
theme[proc_misc]="#00e5ff"
theme[process_start]="#00ff9f"
theme[process_mid]="#f9f871"
theme[process_end]="#ff2a6d"

# Spectrum: background -> bright foreground
theme[gradient_color_0]="#0a0612"
theme[gradient_color_1]="#1c0f2e"
theme[gradient_color_2]="#2a1040"
theme[gradient_color_3]="#5d4a7a"
theme[gradient_color_4]="#7a6b9a"
theme[gradient_color_5]="#b4c8e0"
theme[gradient_color_6]="#d8f0ff"
theme[gradient_color_7]="#f4faff"
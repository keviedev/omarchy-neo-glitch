{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/neo-glitch/skull.txt",
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2,
    },
  },
  "display": {
    "disableLinewrap": true,
    "separator": "  ",
    "color": {
      "keys": "37",
      "title": "90",
    },
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────\u001b[38;2;234;0;217mHARDWARE\u001b[90m─────────────────────┐",
    },
    {
      "type": "host",
      "key": " 󰍹 PC",
      "keyColor": "38;2;0;255;159",
    },
    {
      "type": "cpu",
      "key": "  │ ├󰻠",
      "showPeCoreCount": true,
      "keyColor": "38;2;0;255;159",
    },
    {
      "type": "gpu",
      "key": "  │ ├󰢮",
      "detectionMethod": "pci",
      "format": "{name}",
      "keyColor": "38;2;0;255;159",
    },
    {
      "type": "display",
      "key": "  │ ├󰍹",
      "keyColor": "38;2;0;255;159",
    },
    {
      "type": "disk",
      "key": "  │ ├󰋊",
      "keyColor": "38;2;0;255;159",
    },
    {
      "type": "memory",
      "key": "  │ ├󰍛",
      "keyColor": "38;2;0;255;159",
    },
    {
      "type": "swap",
      "key": "  └ └󰓡 ",
      "keyColor": "38;2;0;255;159",
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────\u001b[38;2;0;229;255mSOFTWARE\u001b[90m─────────────────────┐",
    },
    {
      "type": "command",
      "key": " 󰣇 OS",
      "keyColor": "38;2;0;229;255",
      "text": "version=$(omarchy-version); echo \"Omarchy $version\"",
    },
    {
      "type": "command",
      "key": "  │ ├󰘚",
      "keyColor": "38;2;0;229;255",
      "text": "branch=$(omarchy-version-branch); echo \"$branch\"",
    },
    {
      "type": "command",
      "key": "  │ ├󰔛",
      "keyColor": "38;2;0;229;255",
      "text": "channel=$(omarchy-version-channel); echo \"$channel\"",
    },
    {
      "type": "kernel",
      "key": "  │ ├󰌽",
      "keyColor": "38;2;0;229;255",
    },
    {
      "type": "wm",
      "key": "  │ ├󰧭",
      "keyColor": "38;2;0;229;255",
    },
    {
      "type": "de",
      "key": "  DE",
      "keyColor": "38;2;0;229;255",
    },
    {
      "type": "terminal",
      "key": "  │ ├󰆍",
      "keyColor": "38;2;0;229;255",
    },
    {
      "type": "packages",
      "key": "  │ ├󰏗",
      "keyColor": "38;2;0;229;255",
    },
    {
      "type": "wmtheme",
      "key": "  │ ├󰉼",
      "keyColor": "38;2;0;229;255",
    },
    {
      "type": "command",
      "key": "  │ ├󰏟",
      "keyColor": "38;2;0;229;255",
      "text": "theme=$(omarchy-theme-current); echo -e \"$theme \\e[38;2;234;0;217m●\\e[38;2;255;42;109m●\\e[38;2;0;229;255m●\\e[38;2;0;255;159m●\\e[38;2;249;248;113m●\"",
    },
    {
      "type": "terminalfont",
      "key": "  └ └",
      "keyColor": "38;2;0;229;255",
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────\u001b[38;2;255;42;109mSYSTEM\u001b[90m───────────────────────┐",
    },
    {
      "type": "command",
      "key": " 󱦟 OS Age",
      "keyColor": "38;2;255;42;109",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days",
    },
    {
      "type": "uptime",
      "key": "  󰅐 Uptime",
      "keyColor": "38;2;255;42;109",
    },
    {
      "type": "command",
      "key": "  󰚰 Update",
      "keyColor": "38;2;255;42;109",
      "text": "updated=$(omarchy-version-pkgs); echo \"$updated\"",
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘",
    },
    "break",
  ],
}